# Your Schoology domain (e.g. https://app.schoology.com or https://your-school.schoology.com)
SCHOOLOGY_BASE_URL=https://app.schoology.com

# Your Schoology login username or email
SCHOOLOGY_USERNAME=your-username

# Your Schoology login password
SCHOOLOGY_PASSWORD=your-password

# Optional: School NID if logging in via app.schoology.com for a specific school
# SCHOOLOGY_SCHOOL_NID=
